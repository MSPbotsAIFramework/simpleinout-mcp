# ─── Simple In/Out credentials ───────────────────────────────────────────────
# Per SOP §3.1, credentials come ONLY from per-request HTTP headers sent by
# the Gateway (X-SimpleInOut-Client-Id / X-SimpleInOut-Client-Secret /
# X-SimpleInOut-Refresh-Token) — there is no env-var fallback, so no
# credential values belong in this file or in a real .env.
#
# The refresh_token itself must be obtained once via a one-time interactive
# Authorization Code grant (a human logs in and grants access) — see README.
# For local manual testing, pass your own test credentials directly as
# curl headers (see README "Local testing"), not via environment variables.

# ─── Header names the Gateway is expected to send (not credential values) ────
SIMPLEINOUT_CLIENT_ID_HEADER=X-SimpleInOut-Client-Id
SIMPLEINOUT_CLIENT_SECRET_HEADER=X-SimpleInOut-Client-Secret
SIMPLEINOUT_REFRESH_TOKEN_HEADER=X-SimpleInOut-Refresh-Token

# ─── MCP transport ────────────────────────────────────────────────────────────
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
