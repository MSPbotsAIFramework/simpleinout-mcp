# ─── Simple In/Out API Credentials ───────────────────────────────────────────
# The refresh_token must be obtained once via a one-time interactive
# Authorization Code grant (a human logs in and grants access) — see README.
SIMPLEINOUT_CLIENT_ID=your_client_id
SIMPLEINOUT_CLIENT_SECRET=your_client_secret
SIMPLEINOUT_REFRESH_TOKEN=your_refresh_token

SIMPLEINOUT_CLIENT_ID_HEADER=X-SimpleInOut-Client-Id
SIMPLEINOUT_CLIENT_SECRET_HEADER=X-SimpleInOut-Client-Secret
SIMPLEINOUT_REFRESH_TOKEN_HEADER=X-SimpleInOut-Refresh-Token

# ─── MCP Transport ───────────────────────────────────────────────────────────
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
AUTH_MODE=gateway
